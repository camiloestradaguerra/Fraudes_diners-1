# Terraform Variables - Ejemplo para despliegue en cualquier cuenta AWS
# Copia este archivo a terraform.tfvars y actualiza los valores

# ============================================================
# Variables REQUERIDAS (sin valores por defecto)
# ============================================================

# Identificador de tu cuenta AWS (ej: 761951921633, 123456789012)
aws_account_id = "YOUR_AWS_ACCOUNT_ID"

# ============================================================
# Variables OPCIONALES (con valores por defecto)
# ============================================================

# Región de AWS donde desplegar
aws_region = "us-east-1"

# Nombre del proyecto
project_name = "fraudes"

# Ambiente (prod, dev, staging, etc)
environment = "prod"

# Nombre de la imagen Docker en ECR
docker_image_name = "fraud-detection-api"

# Tag de la imagen Docker
docker_image_tag = "latest"

# Ruta al contexto de Docker build (relativa a este directorio)
docker_build_context = ".."

# Construir imagen Docker localmente antes de desplegar
docker_local_build = true

# Pushear imagen Docker a ECR
enable_docker_push = true

# ============================================================
# Nombres dinámicos (personalizables)
# ============================================================

# Sufijo para el endpoint de SageMaker
# Nombre resultante: "Fraudes-Diners-Prod-Endpoint"
# Formato: ${project_name}-${endpoint_name_suffix}-${environment}-Endpoint
endpoint_name_suffix = "Diners"

# Sufijo para API Gateway
# Nombre resultante: "fraudes-API-prod"
api_gateway_name_suffix = "API"

# ============================================================
# Tipo y cantidad de instancia de SageMaker
# ============================================================

# Tipo de instancia: ml.m5.large, ml.m5.xlarge, ml.c5.large, etc
sagemaker_instance_type = "ml.m5.large"

# Número inicial de instancias
sagemaker_initial_instance_count = 1

# ============================================================
# API Gateway
# ============================================================

# Nombre del stage (prod, dev, etc)
api_gateway_stage = "prod"

# ============================================================
# Tags comunes para todos los recursos
# ============================================================

tags = {
  Environment = "production"
  CreatedBy   = "Terraform"
  CostCenter  = "your-cost-center"
  Team        = "your-team"
}
