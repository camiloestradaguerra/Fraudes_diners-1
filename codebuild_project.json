{
  "name": "fraudes-diners-build",
  "description": "Build Docker image from GitHub to ECR",
  "source": {
    "type": "GITHUB",
    "location": "https://github.com/camiloestradaguerra/Fraudes_diners-1.git",
    "buildspec": "buildspec.yml",
    "gitCloneDepth": 1,
    "gitSubmodulesConfig": {
      "fetchSubmodules": false
    }
  },
  "secondarySourceVersions": [],
  "sourceVersion": "dev_camilo",
  "artifacts": {
    "type": "NO_ARTIFACTS"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "environmentVariables": [
      {
        "name": "AWS_ACCOUNT_ID",
        "value": "822626720556",
        "type": "PLAINTEXT"
      },
      {
        "name": "AWS_DEFAULT_REGION",
        "value": "us-east-1",
        "type": "PLAINTEXT"
      }
    ],
    "privilegedMode": true
  },
  "serviceRole": "arn:aws:iam::822626720556:role/codebuild-fraudes-diners-role",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/fraudes-diners"
    }
  }
}

